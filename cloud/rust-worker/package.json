{
  "name": "tsunoru-rust-worker-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "worker-build --release",
    "build:app": "node build-staging.mjs",
    "test": "node test/staging-real-url-smoke.test.mjs && node verify-local.mjs && node test/verify-cleanup.mjs && node test/staging-build.mjs && node test/verify-staging-origin.mjs",
    "check": "npm run build && npm test",
    "deploy:check": "wrangler deploy --dry-run --env staging",
    "dev:app": "wrangler dev --local --env staging --ip 127.0.0.1 --port 8791 --var APP_ORIGIN:http://localhost:8791",
    "verify:staging-smoke": "node ../../scripts/verify-staging-real-url.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20260903.0-alpha",
    "wrangler": "4.129.0"
  }
}
